{
  "name": "@bianshuhao/dsh-local-prompts",
  "version": "1.0.0",
  "type": "module",
  "description": "A local Markdown prompt panel for DeepSeek Harness, backed by a local folder.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "server.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "lucide-react": "0.470.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "bianshuhao",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "prompts",
    "local"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bianshuhao/dsh-local-prompts.git"
  },
  "homepage": "https://github.com/bianshuhao/dsh-local-prompts#readme",
  "bugs": {
    "url": "https://github.com/bianshuhao/dsh-local-prompts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
